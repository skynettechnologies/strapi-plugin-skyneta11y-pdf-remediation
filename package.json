  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.js",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "styles": "node scripts/build-styles.js",
    "build": "node scripts/build-styles.js && strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test": "node test/config.mjs && node test/smoke.mjs && node test/settings.mjs",
    "prepublishOnly": "node scripts/build-styles.js && strapi-plugin build"
  },
  "dependencies": {},
  "devDependencies": {
    "@strapi/design-system": "^2.2.4",
